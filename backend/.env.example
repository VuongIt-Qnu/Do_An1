# ============================================================
# Hotel Management System CNPM2 - Environment Variables
# Copy this file to .env and fill in real values
# ============================================================

# Flask
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
PORT=5000

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# PostgreSQL
DATABASE_URL=postgresql://hoteluser:hotelpass@localhost:5432/hoteldb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hoteldb
POSTGRES_USER=hoteluser
POSTGRES_PASSWORD=hotelpass

# MongoDB
MONGO_URI=mongodb://localhost:27017/hotel_logs

# Email (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Frontend URL (for password reset links, CORS)
FRONTEND_URL=http://localhost:3000

# Admin default account (used in seed)
ADMIN_EMAIL=admin@hotel.com
ADMIN_PASSWORD=Admin@123456
