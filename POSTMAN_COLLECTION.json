        {
          "name": "Get Room Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/rooms/1"
          }
        },
        {
          "name": "Create Room",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/rooms",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{owner_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"hotel_id\": 1, \"room_number\": \"101\", \"room_type\": \"DELUXE\", \"price_per_night\": 150.00, \"capacity\": 2, \"amenities\": \"WiFi, AC, TV, Mini Bar\", \"description\": \"Cozy deluxe room with city view\"}"
            }
          }
        },
        {
          "name": "Check Availability",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/rooms/1/availability?check_in=2026-04-25&check_out=2026-04-28"
          }
        },
        {
          "name": "Availability Calendar",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/rooms/1/calendar?month=4&year=2026"
          }
        }
      ]
    },
    {
      "name": "📅 Bookings",
