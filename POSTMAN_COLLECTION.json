          }
        },
        {
          "name": "Confirm Booking",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/bookings/1/confirm",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
