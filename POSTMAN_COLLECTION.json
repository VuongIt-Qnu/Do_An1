                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"cancellation_reason\": \"Emergency trip\"}"
            }
          }
        },
        {
          "name": "Add Review",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/bookings/1/review",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"rating\": 5, \"comment\": \"Excellent service and clean rooms!\"}"
            }
          }
        },
        {
          "name": "Get Room Reviews",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/bookings/room/1/reviews?sort_by=recent"
          }
        }
      ]
