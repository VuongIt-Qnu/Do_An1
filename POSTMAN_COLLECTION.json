{
  "info": {
    "name": "Hotel Management API - CNPM2",
    "description": "Complete API collection for Hotel Management System",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"full_name\": \"Test User\", \"email\": \"test{{$timestamp}}@example.com\", \"password\": \"Password123!\", \"phone\": \"+84901234567\"}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"test@example.com\", \"password\": \"Password123!\"}"
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/auth/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"full_name\": \"Updated Name\", \"phone\": \"+84987654321\"}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/refresh",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{refresh_token}}"
              }
            ]
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/logout",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "🏨 Hotels",
      "item": [
        {
          "name": "List Hotels",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/hotels?page=1&per_page=10&city=Hanoi"
          }
        },
        {
          "name": "Get Hotel Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/hotels/1"
          }
        },
        {
          "name": "Create Hotel",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/hotels",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{owner_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"New Hotel\", \"city\": \"Ho Chi Minh\", \"description\": \"Beautiful 4-star hotel\", \"star_rating\": 4, \"address\": \"456 Nguyen St\", \"phone\": \"+84912345679\"}"
            }
          }
        },
        {
          "name": "Update Hotel",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/hotels/1",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{owner_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"description\": \"Updated description\", \"star_rating\": 5}"
            }
          }
        },
        {
          "name": "Delete Hotel",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/hotels/1",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ]
          }
        },
        {
          "name": "Get Hotel Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/hotels/1/stats",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{owner_token}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "🏷️ Rooms",
      "item": [
        {
          "name": "List Rooms",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/rooms?page=1&per_page=20&hotel_id=1"
