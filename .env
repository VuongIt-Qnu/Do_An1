# =============================================================================
# Hotel Management System CNPM2 — Docker Compose Environment
# =============================================================================

# Flask
FLASK_ENV=development
SECRET_KEY=cnpm2-secret-key-dev-2024
JWT_SECRET_KEY=cnpm2-jwt-secret-dev-2024

# PostgreSQL
POSTGRES_DB=hoteldb
POSTGRES_USER=hoteluser
POSTGRES_PASSWORD=hotelpass

# MongoDB
MONGO_DB=hotel_logs

# Email (để trống để bỏ qua gửi email thật)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# Frontend
FRONTEND_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:5000

# JWT expiry
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
